{
  "manifest_version": 3,
  "name": "Movie Companion — Pause & Talk",
  "version": "1.2.0",
  "description": "Pauses any movie at moments you choose and shows a discussion prompt. A family conversation layer for movie night.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://recursive.eco/*",
    "https://*.recursive.eco/*",
    "https://raw.githubusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["prompts/*.json"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Movie Companion"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
